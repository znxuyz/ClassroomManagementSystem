rules_version = '2';

/* ============================================
   Firestore 安全規則
   ────────────────────────────────────────────
   核心原則:
   · 班級資料只有導師本人能寫
   · 學生只能寫自己那份作答,不能改班級、不能改別人的
   · 測驗題目學生只能讀不能寫
   · 名冊索引只讓老師寫,學生讀自己那筆

   部署方式:
     Firebase Console → Firestore Database → 規則 分頁
     把整份內容貼上去,按「發布」
============================================ */

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    /* ---------- 使用者檔案 ---------- */
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    /* ---------- 班級 ---------- */
    match /classes/{classId} {

      function isTeacherOfThisClass() {
        return signedIn() && resource.data.teacherUid == request.auth.uid;
      }

      // 學生要讀班級文件才能看到自己的守護獸與積分。
      // 這代表同班同學的積分彼此看得到 —— 對班級經營來說是刻意的,
      // 投影模式本來就是全班一起看。若要完全隱私,需改為每位學生獨立文件。
      allow read: if signedIn();

      // 只有導師本人能改班級資料,學生完全寫不進來
      allow update, delete: if isTeacherOfThisClass();

      // 建立班級時,teacherUid 必須是自己,不能冒名建給別人
      allow create: if signedIn()
                    && request.resource.data.teacherUid == request.auth.uid;

      /* 測驗題目:學生只讀,老師才能寫 */
      match /quizzes/{quizId} {
        allow read: if signedIn();
        allow write: if signedIn()
          && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
      }

      /* 學生自選守護獸:
         文件 id 就是學生的 uid,所以只能寫自己那一份。
         老師端會讀取並收進班級資料(且只填補還沒有守護獸的學生)。 */
      match /petChoices/{uid} {
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }
        allow create, update: if signedIn()
                              && request.auth.uid == uid
                              && request.resource.data.uid == uid;
        allow read: if isClassTeacher() || (signedIn() && request.auth.uid == uid);
        allow delete: if isClassTeacher();
      }

      /* 獎品兌換申請:
         學生只能建立自己的申請,而且不能自己決定結果 ——
         status 必須是 pending,實際扣點與核可都在老師端執行。
         建立之後學生就不能再改,避免把 rejected 改回 paid。 */
      match /purchases/{purchaseId} {
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }
        allow create: if signedIn()
                      && request.resource.data.uid == request.auth.uid
                      && request.resource.data.status == 'pending';
        allow read: if isClassTeacher()
                    || (signedIn() && resource.data.uid == request.auth.uid);
        allow update, delete: if isClassTeacher();
      }

      /* 領地戰的設定與題目:學生只讀不寫。
         answers 這一份含正確答案,學生連讀都不行 ——
         但下面的規則讀得到,用來驗證作答。 */
      match /territory/{docId} {
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }
        // answers 只有老師讀得到;其餘(config、questions)全班可讀
        allow read: if isClassTeacher() || (signedIn() && docId != 'answers');
        allow write: if isClassTeacher();
      }

      /* 領地戰的作答事件。
         這是整個遊戲唯一的真實來源 —— 地圖是由這些事件重播出來的,
         所以驗證必須在這裡做到位。規則會比對老師設定的正確答案,
         答錯的事件根本寫不進來;組別與佔領分也都從伺服器端的資料核對,
         學生改前端沒有用。寫入後不可修改,免得事後竄改。 */
      match /tevents/{eventId} {
        function cfg() {
          return get(/databases/$(database)/documents/classes/$(classId)/territory/config).data;
        }
        function answerKey() {
          return get(/databases/$(database)/documents/classes/$(classId)/territory/answers).data.key;
        }
        function q() {
          return answerKey()[request.resource.data.questionId];
        }
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }

        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          // 文件 id 綁定「誰 + 哪一題」,同一題每人只能答一次。
          // 加上 update 一律禁止,學生就無法對記住答案的題目重複刷分。
          && eventId == request.auth.uid + '_' + request.resource.data.questionId
          // 遊戲要在進行中
          && cfg().status == 'running'
          // 題目必須存在,而且答案要正確
          && request.resource.data.questionId in answerKey()
          && request.resource.data.answer == q().a
          // 佔領分由題目難度決定,不能自己填
          && request.resource.data.points == q().p
          // 組別以老師的分組為準
          && request.resource.data.groupIdx == cfg().memberGroup[request.resource.data.studentId]
          // 時間戳一律用伺服器的,先後才不受學生裝置時鐘影響
          && request.resource.data.at == request.time;

        allow read: if signedIn();
        allow update: if false;
        allow delete: if isClassTeacher();
      }

      /* 學生作答:
         · 學生只能建立/修改 id 為 {quizId}__{自己的uid} 的那一份
         · 而且文件裡的 uid 欄位必須等於自己,不能偽造成別人
         · 老師可以讀全部(要批改),但不能代寫 */
      /* 每日備份:只有導師看得到、寫得了。
         學生完全碰不到,也不需要 —— 這是給老師救資料用的。 */
      match /backups/{backupId} {
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }
        allow read, write: if isClassTeacher();
      }

      /* 逐題搶答:一題一份文件,只能建立不能修改。
         · 文件 id 綁定「哪份測驗 + 誰 + 哪一題」,所以同一題只能答一次
         · 時間戳必須是伺服器時間,學生無法把自己的作答時間改早
         · 測驗要在開放中
         正確與否不在這裡判斷 —— 答案留在老師手上,結算時才批改,
         所以規則不需要、也不會碰到正確答案。 */
      match /qanswers/{ansId} {
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }
        function quizOpen() {
          return get(/databases/$(database)/documents/classes/$(classId)/quizzes/$(request.resource.data.quizId)).data.status == 'open';
        }

        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && ansId == request.resource.data.quizId + '__' + request.auth.uid
                      + '__' + request.resource.data.questionId
          && request.resource.data.at == request.time
          && quizOpen();

        allow read: if isClassTeacher()
                    || (signedIn() && resource.data.uid == request.auth.uid);
        allow update: if false;
        allow delete: if isClassTeacher();
      }

      match /submissions/{subId} {
        function isMine() {
          return signedIn()
                 && request.resource.data.uid == request.auth.uid
                 && subId.matches('.*__' + request.auth.uid);
        }
        function isClassTeacher() {
          return signedIn()
            && get(/databases/$(database)/documents/classes/$(classId)).data.teacherUid == request.auth.uid;
        }

        allow create, update: if isMine();
        allow read: if isClassTeacher()
                    || (signedIn() && resource.data.uid == request.auth.uid);
        allow delete: if isClassTeacher();
      }
    }

    /* ---------- 名冊索引 ----------
       學生用 email 查自己屬於哪些班。
       只允許讀自己那一筆,不能拿去掃描全校名單。
       寫入開放給已登入者,是因為規則層無法得知寫入者是不是
       某個班的導師(文件 id 是學生 email,不含班級資訊)。
       實務上這是可接受的取捨:寫入者必須先知道對方 email,
       且寫錯只會導致學生看到不存在的班級,讀不到任何資料 ——
       真正的資料防線在上面的 classes 規則。 */
    match /rosterIndex/{emailKey} {
      allow read:  if signedIn() && emailKey == myEmail();
      allow write: if signedIn();
    }
  }
}
